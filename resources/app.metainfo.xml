<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>dev.edfloreshz.ModeToggle</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-only</project_license>
  <name>Mode Toggle</name>
  <summary>Switch between light and dark mode from the COSMIC panel</summary>
  <description>
    <p>Mode Toggle adds a button to your panel or dock that switches the system appearance between light and dark mode. The sun and moon show the active mode, and hovering over the button previews the mode a click will activate.</p>
  </description>
  <url type="homepage">https://github.com/cosmic-utils/cosmic-ext-applet-mode-toggle</url>
  <url type="vcs-browser">https://github.com/cosmic-utils/cosmic-ext-applet-mode-toggle</url>
  <launchable type="desktop-id">dev.edfloreshz.ModeToggle.desktop</launchable>
  <provides>
    <id>com.system76.CosmicApplet</id>
    <binary>cosmic-ext-applet-mode-toggle</binary>
  </provides>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>touch</control>
  </supports>
  <categories>
    <category>COSMIC</category>
  </categories>
  <keywords>
    <keyword>COSMIC</keyword>
  </keywords>
  <content_rating type="oars-1.1" />
</component>
